local mon_premier_avion = Avion.creer("Airbus A320", 5000)

-- 1. On déclare d'abord le moule et le manuel commun
Avion = {}
Avion.__index = Avion

-- 2. On crée la fonction usine (j'ai tout harmonisé avec "nouvel_avion")
function Avion.creer(nom_modele, capacite_carburant)
	local nouvel_avion = {}
	
	setmetatable(nouvel_avion, Avion) -- Connexion au manuel commun corrigée
	
	nouvel_avion.nom = nom_modele
	nouvel_avion.carburant = capacite_carburant
	nouvel_avion.altitude = 0
	
	return nouvel_avion
end

-- 3. Tout à la fin, on peut ENFIN utiliser l'usine en sécurité !
